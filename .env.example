# Copy to .env.local and fill in. This file is committed; .env.local is not.

# --- Supabase ---------------------------------------------------------------
# Both values are safe for the browser — row level security is what protects
# the data, not the key. Never put the service role key in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Business figures -------------------------------------------------------
# Every commercially sensitive number lives here rather than in source: contract
# values, revenue targets, staff quotas and contractor rates. Several are
# individual compensation terms covered by confidentiality clauses, so they must
# never be committed — not in code, not in a default, not in a comment.
#
# All are read in lib/config.ts. An unset value falls back to 0, which renders
# honest zeroes rather than NaN, so a dashboard showing RM 0 everywhere means
# the environment is incomplete.

# Capital raise. The deadline is as disclosive as the target — together they
# describe the whole raise — so it lives here too. Format: YYYY-MM-DD.
NEXT_PUBLIC_FUNDRAISING_TARGET=
NEXT_PUBLIC_NASDAQ_PAT_TARGET=
NEXT_PUBLIC_FUNDRAISING_DEADLINE=
NEXT_PUBLIC_CAMPAIGN_START=

# Deal structures
NEXT_PUBLIC_FACTORY_DISBURSEMENT=
NEXT_PUBLIC_FACTORY_HQ_INVESTMENT=
NEXT_PUBLIC_MDNA_PACKAGE=
NEXT_PUBLIC_MDNA_HQ_INVESTMENT=
NEXT_PUBLIC_INTRODUCER_COMMISSION=

# MEC annual revenue stream targets
NEXT_PUBLIC_MEC_TARGET_CEC=
NEXT_PUBLIC_MEC_TARGET_SPONSOR=
NEXT_PUBLIC_MEC_TARGET_SUBSCRIPTION=
NEXT_PUBLIC_MEC_TARGET_ADVISORY=
NEXT_PUBLIC_MEC_TARGET_TRAINING=
NEXT_PUBLIC_MEC_TARGET_PAYROLL=

# Individual compensation — the most sensitive values in this file
NEXT_PUBLIC_MEC_PARTNERSHIP_QUOTA=
NEXT_PUBLIC_MEC_REVENUE_PER_STAFF_MIN=
NEXT_PUBLIC_MEC_REVENUE_PER_STAFF_MAX=
NEXT_PUBLIC_LIFESTYLE_MONTHLY_FEE=
NEXT_PUBLIC_RATE_EDM=
NEXT_PUBLIC_RATE_FB_EVENT=
NEXT_PUBLIC_RATE_CEC_PROFILE=
NEXT_PUBLIC_RATE_DIGITAL_ACCESS=
